<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>true</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>DualRoleAdventure</AssemblyName>
    <RootNamespace>DualRoleAdventure</RootNamespace>

    <!-- 游戏安装目录。优先级：-p:Sts2Dir=<path>  >  环境变量 STS2_DIR  >  下面的平台默认值。
         ⚠ 路径统一用正斜杠（/）：Windows 与 Linux 的 MSBuild 都把它当目录分隔符；
         而反斜杠在 Linux 下**不是**分隔符（会被当成文件名的一部分），会让跨平台构建找不到 dll。
         Linux / WSL 下请覆盖（路径含空格要加引号）：
           dotnet build LocalMultiControl.csproj -c Release -p:Sts2Dir=/mnt/d/SteamLibrary/"steamapps/common/Slay the Spire 2"
         ⚠ 改这几行前先看 Scripts/Tools/clr_compat_check.py 的 resolve_game_dir —— 它按正则读这里的
         具体路径（会自动跳过 $(STS2_DIR) 这类未展开的变量值）。 -->
    <Sts2Dir Condition="'$(Sts2Dir)' == '' AND '$(STS2_DIR)' != ''">$(STS2_DIR)</Sts2Dir>
    <Sts2Dir Condition="'$(Sts2Dir)' == ''">D:/SteamLibrary/steamapps/common/Slay the Spire 2</Sts2Dir>
    <Sts2DataDir>$(Sts2Dir)/data_sts2_windows_x86_64</Sts2DataDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- 反编译游戏源码是只读参考，绝不能参与编译：
           编译进去会导致 DLL 体积暴涨、类型重复、依赖混入且极难排查。
           src/**   = 仓库内的反编译源码（历史约定）
           sts2src/** = 仓库外反编译源码被拷进仓库时的目录（AGENTS.md §1）
           新增任何反编译目录都必须在这里同步加排除，Guard 目标会兜底校验。 -->
    <Compile Remove="src/**" />
    <Compile Remove="sts2src/**" />
    <None Remove="src/**" />
    <None Remove="sts2src/**" />
    <!-- Unit tests live in tests/; never compile them into the mod assembly -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <!-- 源码隔离 Guard（AGENTS.md §9 门禁 2）：
       兜底拦截任何漏网的反编译源码进入编译，并输出参与编译的 .cs 数量供人工审计。 -->
  <Target Name="GuardDecompiledSourceIsolation" BeforeTargets="BeforeCompile">
    <ItemGroup>
      <_DecompiledLeak Include="@(Compile)"
                       Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(FullPath)', '[\\/](src|sts2src|decompiled)[\\/]', 'System.Text.RegularExpressions.RegexOptions.IgnoreCase'))" />
    </ItemGroup>
    <Error Condition="'@(_DecompiledLeak)' != ''"
           Text="[SOURCE-ISOLATION] 反编译游戏源码被纳入编译，已阻止构建：@(_DecompiledLeak, '%0A  ')%0A请在 LocalMultiControl.csproj 的 &lt;Compile Remove=&quot;...&quot; /&gt; 中排除该目录（见 AGENTS.md §1）。" />
    <Message Text="[SOURCE-ISOLATION] 通过；参与编译的 .cs 数量 = @(Compile->Count())" Importance="high" />
  </Target>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Steamworks.NET">
      <HintPath>$(Sts2DataDir)/Steamworks.NET.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 构建后将 DLL 放到项目根目录，供部署脚本统一复制 -->
  <Target Name="CopyDllToProjectRoot" AfterTargets="Build">
    <Message Text="Copying DLL to project root..." Importance="high" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(MSBuildProjectDirectory)\$(AssemblyName).dll" />
  </Target>

  <!-- 结构化 BuildIdentity（AGENTS.md §9）：git commit + 构建时间生成源文件 BuildIdentity.g.cs。
       日志 BUILD_ID 可直接回答「这一版从哪个 commit、何时构建」。git 不可用时回退 no-git。

       踩坑记录：
       r89 - 顶层 <ItemGroup> AssemblyMetadata 在 Target 前静态求值，值锁死在初始值 → no-git。
       r90 - 改 BeforeTargets=GenerateAssemblyInfo + Target 内 ItemGroup，但 **Godot.NET.Sdk 下
             GenerateAssemblyInfo 从未被调度**，三个值全丢 → unknown。
       结论：不走 AssemblyMetadata，直接生成一个 .g.cs 源文件加入 @(Compile)，必然进汇编。 -->
  <Target Name="WriteBuildIdentitySource" BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="git -C $(MSBuildProjectDirectory) rev-parse --short HEAD"
          ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommit" />
    </Exec>
    <Exec Command="git -C $(MSBuildProjectDirectory) status --porcelain"
          ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitDirtyRaw" />
    </Exec>
    <PropertyGroup>
      <GitCommit Condition="'$(GitCommit)' == ''">no-git</GitCommit>
      <GitDirty Condition="'$(GitDirtyRaw)' != ''">dirty</GitDirty>
      <GitDirty Condition="'$(GitDirtyRaw)' == ''">clean</GitDirty>
      <BuildTimeUtc>$([System.DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ'))</BuildTimeUtc>
      <BuildIdentityFile>$(IntermediateOutputPath)BuildIdentity.g.cs</BuildIdentityFile>
    </PropertyGroup>
    <ItemGroup>
      <!-- 注意：C# 分号在 MSBuild item include 里是列表分隔符，必须写 %3B；否则会被吞（实测踩中） -->
      <_BILines Include="// &lt;auto-generated&gt; by LocalMultiControl.csproj (WriteBuildIdentitySource)" />
      <_BILines Include="namespace LocalMultiControl.Scripts.Runtime" />
      <_BILines Include="{" />
      <_BILines Include="    internal static class BuildIdentity" />
      <_BILines Include="    {" />
      <_BILines Include="        internal const string GitCommit = &quot;$(GitCommit)&quot;%3B" />
      <_BILines Include="        internal const string GitDirty = &quot;$(GitDirty)&quot;%3B" />
      <_BILines Include="        internal const string BuildTimeUtc = &quot;$(BuildTimeUtc)&quot;%3B" />
      <_BILines Include="    }" />
      <_BILines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(BuildIdentityFile)" Overwrite="true" Encoding="UTF-8" Lines="@(_BILines)" />
    <ItemGroup>
      <Compile Include="$(BuildIdentityFile)" />
    </ItemGroup>
  </Target>
</Project>
